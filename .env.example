# Public site origin used for canonical URLs, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.smlegalservice.com

# Optional: send contact-form enquiries by email. If none of these are set,
# validated enquiries are written to .data/inquiries.jsonl on the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=manoj@smlegalservice.com
CONTACT_FROM_EMAIL=noreply@smlegalservice.com
RESEND_API_KEY=

# Optional webhook that receives JSON { to, subject, record }
CONTACT_WEBHOOK_URL=
